# Local development only (docker-compose). Runs uvicorn directly instead of
# the Lambda Runtime Interface Client — the deployed image (backend/Dockerfile)
# is built on the AWS Lambda base image and is not usable this way.
FROM python:3.11-slim

WORKDIR /app

COPY pyproject.toml ./
COPY src ./src
COPY alembic.ini ./
COPY alembic ./alembic

RUN pip install --no-cache-dir .

EXPOSE 8000

CMD ["uvicorn", "trading_backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
