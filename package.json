{
  "name": "trading-recommendation-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "dev": "concurrently -n docker,frontend -c blue,green -k \"docker compose up --build\" \"pnpm --filter frontend dev\"",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml}\""
  },
  "lint-staged": {
    "*.{ts,tsx,md,json,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3"
  }
}
